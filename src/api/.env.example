# Copy to .env for local runs (never commit a real .env). Auth is keyless: sign in with `az login`
# locally; in Azure the user-assigned managed identity is selected through AZURE_CLIENT_ID.
FOUNDRY_PROJECT_ENDPOINT=https://<foundry-resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_MODEL_DEPLOYMENT=gpt-5.4-mini
FOUNDRY_FAST_MODEL_DEPLOYMENT=gpt-5.4-nano
FOUNDRY_AGENT_NAME=foundry-guide
# FOUNDRY_AGENT_BOOTSTRAP=true
# AZURE_CLIENT_ID=<uami-client-id>
# APPLICATIONINSIGHTS_CONNECTION_STRING=
# APP_VERSION=dev
# AZURE_REGION=swedencentral
# STATIC_DIR=../web/dist
# LOG_LEVEL=INFO
