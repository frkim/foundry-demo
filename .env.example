# Example configuration for running the Foundry Guide API locally.
# Copy to src/api/.env (git-ignored) and replace the placeholders. Never commit real values.
# Authentication is keyless: sign in with `az login` locally; in Azure the user-assigned managed identity is used.

# Foundry project endpoint (Foundry resource + project, Microsoft Foundry new)
FOUNDRY_PROJECT_ENDPOINT=https://<foundry-resource-name>.services.ai.azure.com/api/projects/proj-foundrydemo-dev

# Model deployment used by the agent (primary)
FOUNDRY_MODEL_DEPLOYMENT=gpt-5.4-mini

# Fast model deployment used by the model comparison
FOUNDRY_FAST_MODEL_DEPLOYMENT=gpt-5.4-nano

# Name of the Foundry agent created at startup
FOUNDRY_AGENT_NAME=foundry-guide

# Client ID of the user-assigned managed identity (set in Azure; leave empty locally to use your az login)
AZURE_CLIENT_ID=

# Application Insights connection string (optional locally; telemetry is disabled when empty)
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Application version shown in /api/info (the deploy workflow sets the git SHA)
APP_VERSION=local
